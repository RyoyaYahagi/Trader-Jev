# Copy this file to .env and load it into the process environment before use.
# Never commit the real .env file or put a real credential in this template.

# Used only by the server-side TypeSafe SDK bridge to call Vercel AI Gateway.
# Never expose this value to browser code or commit a real key.
AI_GATEWAY_API_KEY=
# Vercel may provide this server-side OIDC credential at runtime instead.
# VERCEL_OIDC_TOKEN=

# TypeSafe's published Jev rate: USD per 1,000 tokens. Output is free.
JEV_INPUT_PRICE_USD_PER_1K_TOKENS=0.000042
JEV_OUTPUT_PRICE_USD_PER_1K_TOKENS=0
# JEV_REQUEST_PRICE_USD=
JEV_PRICE_CURRENCY=USD
JEV_MODEL=jev-latest
JEV_TIMEOUT_SECONDS=5
JEV_MAX_RESPONSE_BYTES=65536

# moomoo OpenD is a separate local gateway.  OpenD handles its own login;
# Trader-Jev does not read or store brokerage credentials.
MOOMOO_OPEND_HOST=127.0.0.1
MOOMOO_OPEND_PORT=11111
MOOMOO_POLL_INTERVAL_SECONDS=1.0
MOOMOO_REQUEST_BATCH_SIZE=400
