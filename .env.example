# Copy this file to .env and load it into the process environment before use.
# Never commit the real .env file or put a real credential in this template.

JEV_API_KEY=
# TypeSafe's documented name is TYPESAFE_API_KEY; either variable is accepted.
# TYPESAFE_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
JEV_ENDPOINT_PATH=/v1/systemone
JEV_MODEL=jev-latest
JEV_TIMEOUT_SECONDS=5
JEV_MAX_RESPONSE_BYTES=65536

# Defaults are standard Bearer authentication.  For an X-API-Key style service:
# JEV_API_KEY_HEADER=X-API-Key
# JEV_API_KEY_SCHEME=
