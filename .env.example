# Copy this file to .env and load it into the process environment before use.
# Never commit the real .env file or put a real credential in this template.

# Preferred on the shared workstation: Jev Gateway keeps the upstream key in pass.
JEV_GATEWAY_URL=http://127.0.0.1:4789/v1/systemone
# Set only when the local Gateway was configured with a separate access token.
# JEV_GATEWAY_TOKEN=

# Direct TypeSafe access is an explicit fallback only. Leave these empty when
# the Gateway is available. The upstream credential must never be committed.
# JEV_API_KEY=
# TypeSafe's documented name is TYPESAFE_API_KEY; either variable is accepted.
# TYPESAFE_API_KEY=

# TypeSafe's published Jev rate: USD per 1,000 tokens. Output is free.
JEV_INPUT_PRICE_USD_PER_1K_TOKENS=0.000042
JEV_OUTPUT_PRICE_USD_PER_1K_TOKENS=0
# JEV_REQUEST_PRICE_USD=
JEV_PRICE_CURRENCY=USD
JEV_BASE_URL=https://api.typesafe.ai
JEV_ENDPOINT_PATH=/v1/systemone
JEV_MODEL=jev-latest
JEV_TIMEOUT_SECONDS=5
JEV_MAX_RESPONSE_BYTES=65536

# Defaults are standard Bearer authentication.  For an X-API-Key style service:
# JEV_API_KEY_HEADER=X-API-Key
# JEV_API_KEY_SCHEME=

# moomoo OpenD is a separate local gateway.  OpenD handles its own login;
# Trader-Jev does not read or store brokerage credentials.
MOOMOO_OPEND_HOST=127.0.0.1
MOOMOO_OPEND_PORT=11111
MOOMOO_POLL_INTERVAL_SECONDS=1.0
MOOMOO_REQUEST_BATCH_SIZE=400
