/var
/models
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.db
*.db-*
*.log

# TypeSafe SDK dependencies and generated bridge
/jev-sdk/node_modules
/jev-sdk/dist

# Local operating-system metadata
.DS_Store
Thumbs.db
