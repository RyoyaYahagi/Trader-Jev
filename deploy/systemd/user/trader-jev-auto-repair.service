[Unit]
Description=Diagnose and repair one failed Trader-Jev Paper run with Codex
After=trader-jev-forward-paper.service

[Service]
Type=oneshot
WorkingDirectory=/home/yappa/dev/app/Trader-Jev
ExecStart=/home/yappa/dev/app/Trader-Jev/.venv/bin/python -m trader_jev.auto_repair --repo /home/yappa/dev/app/Trader-Jev --state-dir %h/.local/state/trader-jev --unit trader-jev-forward-paper.service --codex /home/yappa/.local/bin/codex
TimeoutStartSec=14400
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
InaccessiblePaths=/home/yappa/dev/app/Trader-Jev/.env
StandardOutput=journal
StandardError=journal
